# Dependencies
node_modules/
package-lock.json.backup

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Application Logs & Error Records
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Temporary Directories
uploads/
tmp/
temp/
*.tmp

# Editor & IDE Directories
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
.DS_Store?
._*
Thumbs.db
desktop.ini