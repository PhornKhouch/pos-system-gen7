# ==========================================
# 🛒 FullStack POS Monorepo - Git Ignore
# ==========================================

# Dependencies (Root, Frontend, Backend)
node_modules/
*/node_modules/
client/node_modules/
node-api/node_modules/

# Production Build Outputs
dist/
dist-ssr/
build/
client/dist/
client/dist-ssr/
client/build/

# Environment Variables & Secrets
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
node-api/.env
node-api/.env.*
!node-api/.env.example

# Logs & Error Outputs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
node-api/logs/*.log

# IDE & Editor Configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Temporary files & Caches
.cache/
.temp/
tmp/
*.tmp
